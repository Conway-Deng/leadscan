# Copy this file to .env and put your real keys after the = sign.
# .env is git-ignored. Never commit it and never share it.

# Required for --sweep. Enable "Places API (New)" for the project in the
# Google Cloud console, then restrict the key to that one API.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OPTIONAL and EU/UK only. Read the note at the top of adlibrary.py before you
# spend time on this: the Meta Ad Library API returns commercial ads for EU and
# UK audiences only, so it cannot confirm a live ad for a Singapore business.
# META_AD_LIBRARY_TOKEN=

# ---------------------------------------------------------------------------
# Optional tuning. Every value has a working default in config.py.
# ---------------------------------------------------------------------------
# LEADSCAN_QUIET_REVIEWS=30          # at or below this, the firm is "quiet"
# LEADSCAN_ESTABLISHED_REVIEWS=60    # above this, a site error is a blip
# LEADSCAN_INFLUENCER_FOLLOWERS=20000
# LEADSCAN_SOCIAL_MAX_FOLLOWERS=3000
# LEADSCAN_SLOW_SECONDS=5
# LEADSCAN_POLITE_DELAY=1.0          # seconds between hits on different sites
# LEADSCAN_CACHE_TTL_HOURS=168
# LEADSCAN_REGION_CODE=SG
# LEADSCAN_PLACES_LEGACY=0           # 1 forces the old Places endpoints
