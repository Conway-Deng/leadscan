# Copy this file to .env and put your real keys after the = sign.
# .env is git-ignored. Never commit it and never share it.

# Required for --sweep. Enable "Places API (New)" for the project in the
# Google Cloud console, then restrict the key to that one API.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OPTIONAL and EU/UK only. Read the note at the top of adlibrary.py before you
# spend time on this: the Meta Ad Library API returns commercial ads for EU and
# UK audiences only, so it cannot confirm a live ad for a Singapore business.
# META_AD_LIBRARY_TOKEN=

# ---------------------------------------------------------------------------
# Optional tuning. Every value has a working default in config.py.
# ---------------------------------------------------------------------------
# LEADSCAN_QUIET_REVIEWS=30          # at or below this, the firm is "quiet"
# LEADSCAN_ESTABLISHED_REVIEWS=60    # above this, a site error is a blip
# LEADSCAN_INFLUENCER_FOLLOWERS=20000
# LEADSCAN_SOCIAL_MAX_FOLLOWERS=3000
# LEADSCAN_SLOW_SECONDS=5
# LEADSCAN_BUSINESS_TIMEOUT_SECONDS=90 # total budget for one business audit
# LEADSCAN_POLITE_DELAY=1.0          # seconds between hits on different sites
# LEADSCAN_CACHE_TTL_HOURS=168
# LEADSCAN_REGION_CODE=SG
# LEADSCAN_PLACES_LEGACY=0           # 1 forces the old Places endpoints

# ---------------------------------------------------------------------------
# Hosted public audit lead capture
# ---------------------------------------------------------------------------
# Preferred hosted/shared persistence: a Postgres connection URL supplied by
# the deployment platform. Keep the real URL and credentials in hosted secrets.
# DATABASE_URL=

# SQLite fallback for local development or a single-instance deployment with a
# persistent private volume. Do not use an ephemeral filesystem for real leads.
# LEADSCAN_LEAD_DB_PATH=/data/leadscan-public-leads.sqlite3

# Optional remote Browserless CDP backend. Configure both values together.
# Keep the real endpoint credentials in hosted secrets.
# BROWSERLESS_ENDPOINT=
# BROWSERLESS_TOKEN=

# ---------------------------------------------------------------------------
# Hosted public audit worker CORS origin
# ---------------------------------------------------------------------------
# Exact HTTPS origin of the independently hosted public frontend (e.g. Netlify).
# Do not include a path, query string, fragment, or wildcard.
# When omitted or blank, CORS support is disabled (same-origin only).
# LEADSCAN_ALLOWED_ORIGIN=https://your-site.netlify.app
